"""
Kilawatt Cloud + vLLM High-Throughput Inference Example
"""

from kilawatt import Kilawatt

client = Kilawatt(api_key="kw_test_sandbox_12345")

def launch_vllm_cluster():
    print("Provisioning vLLM high-concurrency inference endpoint...")
    
    response = client.deploy(
        gpu_type="nvidia-b200",
        count=8,
        dry_run=True
    )
    
    print("Cluster Allocated:", response["reservation"]["gpu_type"])
    print("Node Count:", response["reservation"]["allocated_count"])

if __name__ == "__main__":
    launch_vllm_cluster()
